{
  "name": "qsimcity",
  "version": "1.0.0",
  "private": true,
  "description": "QSimCity — an explorable 3D quantum city driven by real computation traces. Unofficial, independent, open-source educational and research visualization project.",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter qsimcity-web dev",
    "build": "pnpm --filter qsimcity-web build",
    "preview": "pnpm --filter qsimcity-web preview",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "tsx tools/mutation/run-mutation.ts",
    "check:names": "tsx tools/check-prohibited-names.ts",
    "check:language": "tsx tools/check-language.ts",
    "check:todos": "tsx tools/check-todos.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:names && pnpm check:language && pnpm check:todos && pnpm test",
    "verify:release": "pnpm verify && pnpm test:coverage && pnpm build && pnpm check:perf && pnpm test:e2e && pnpm test:mutation",
    "goal:check": "tsx tools/check-goal.ts",
    "check:perf": "tsx tools/check-performance.ts",
    "soak": "tsx tools/soak/run-soak.ts",
    "lighthouse": "tsx tools/lighthouse/run-lighthouse.ts",
    "coverage:check": "tsx tools/coverage/check-coverage.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "chrome-launcher": "1.2.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "4.9.0",
    "happy-dom": "20.11.1",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "tslib": "2.8.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
